---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Planificador Semanal</title>

		<style>
			@media print {
				@page {
					size: landscape;
					margin: 0.5cm;
				}
				body {
					-webkit-print-color-adjust: exact;
					print-color-adjust: exact;
					background-color: white !important;
				}
				.no-print {
					display: none !important;
				}
				input {
					border: none !important;
					background: transparent !important;
				}
				::-webkit-scrollbar {
					display: none;
				}
				.print-container {
					box-shadow: none !important;
					border: 1px solid #e5e7eb !important;
				}
			}
		</style>
		<!-- Google tag (gtag.js) -->
		<script
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-JMVWGDFGG8"
		></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-JMVWGDFGG8");
		</script>
	</head>
	<body
		class="bg-background-light dark:bg-background-dark font-display text-[#131615] dark:text-[#f1f3f3] min-h-screen flex flex-col overflow-x-hidden transition-colors duration-200"
	>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
