---
import Layout from "../layouts/Layout.astro";
import {
	IconDownload,
	IconTrash,
	IconCalendarEvent,
} from "@tabler/icons-react";
import Calendar from "../components/Calendar";
---

<Layout>
	<header
		class="sticky top-0 z-50 w-full bg-white/90 dark:bg-surface-dark/90 backdrop-blur-md border-b border-[#f1f3f3] dark:border-gray-800 shadow-sm print:static print:border-none print:bg-white"
	>
		<div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
			<div
				class="flex flex-col md:flex-row items-center justify-between gap-4"
			>
				<div class="flex items-center gap-3 select-none">
					<div
						class="flex items-center justify-center size-10 rounded-xl bg-primary/10 text-primary print:border print:border-primary/20"
					>
						<IconCalendarEvent stroke={1.25} />
					</div>
					<div>
						<h1
							id="header-title"
							class="text-xl font-extrabold tracking-tight leading-none text-gray-900 dark:text-white print:text-black"
						>
							Planificador Semanal
						</h1>
						<p
							id="header-subtitle"
							class="text-xs text-gray-500 dark:text-gray-400 font-medium print:text-gray-600"
						>
							Horario de productividad
						</p>
					</div>
				</div>
				<div
					class="flex flex-wrap items-center gap-3 md:gap-4 justify-center md:justify-end w-full md:w-auto no-print"
				>
					<div
						class="flex h-10 items-center bg-[#f1f3f3] dark:bg-gray-800 p-1 rounded-lg"
					>
						<label
							class="group flex cursor-pointer relative items-center justify-center h-full px-3 rounded-md transition-all"
						>
							<input
								class="peer sr-only"
								name="lang"
								type="radio"
								value="EN"
							/>
							<span
								class="absolute inset-0 bg-white dark:bg-gray-700 shadow-sm rounded-md opacity-0 peer-checked:opacity-100 transition-opacity duration-200"
							></span>
							<span
								class="relative z-10 text-xs font-bold text-gray-500 peer-checked:text-gray-900 dark:text-gray-400 dark:peer-checked:text-white"
								>EN</span
							>
						</label>
						<label
							class="group flex cursor-pointer relative items-center justify-center h-full px-3 rounded-md transition-all"
						>
							<input
								class="peer sr-only"
								name="lang"
								type="radio"
								value="ES"
							/>
							<span
								class="absolute inset-0 bg-white dark:bg-gray-700 shadow-sm rounded-md opacity-0 peer-checked:opacity-100 transition-opacity duration-200"
							></span>
							<span
								class="relative z-10 text-xs font-bold text-gray-500 peer-checked:text-gray-900 dark:text-gray-400 dark:peer-checked:text-white"
								>ES</span
							>
						</label>
					</div>
					<div
						class="w-px h-8 bg-gray-200 dark:bg-gray-700 hidden sm:block"
					>
					</div>
					<div class="flex items-center gap-2">
						<button
							id="btn-clear"
							class="flex items-center justify-center h-10 px-4 rounded-lg text-sm font-bold text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors gap-2 group"
							onclick="window.dispatchEvent(new CustomEvent('calendar-clear'))"
						>
							<IconTrash stroke={1.25} />
							<span class="hidden sm:inline" id="label-clear"
								>Borrar Todo</span
							>
						</button>
						<button
							id="btn-download"
							class="flex items-center justify-center h-10 px-5 rounded-lg bg-primary hover:bg-primary-dark text-white text-sm font-bold shadow-lg shadow-primary/25 transition-all active:scale-95 gap-2"
						>
							<IconDownload stroke={1.25} />
							<span id="label-download">Descargar PDF</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</header>
	<main
		class="flex-grow w-full max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-8 print:p-0 print:max-w-none print:w-full relative"
	>
		<Calendar client:load />
	</main>
	<footer
		class="py-6 text-center text-xs text-gray-400 dark:text-gray-600 no-print"
	>
		<p id="footer-text">
			© 2026 Planificador Semanal. Diseño enfocado en claridad.
		</p>
	</footer>

	<script>
		import { translations, type Language } from "../lib/i18n";
		import html2canvas from "html2canvas";
		import { jsPDF } from "jspdf";

		const updateUI = (lang: Language) => {
			const t = translations[lang];
			const title = document.getElementById("header-title");
			const subtitle = document.getElementById("header-subtitle");
			const labelClear = document.getElementById("label-clear");
			const labelDownload = document.getElementById("label-download");
			const footerText = document.getElementById("footer-text");

			if (title) title.textContent = t.title;
			if (subtitle) subtitle.textContent = t.subtitle;
			if (labelClear) labelClear.textContent = t.clearAll;
			if (labelDownload) labelDownload.textContent = t.downloadPDF;
			if (footerText)
				footerText.textContent = `© 2026 ${t.title}. Diseño enfocado en claridad.`;
		};

		// 1. Detect language
		let currentLang = localStorage.getItem("calendar-lang") as Language;
		if (!currentLang || (currentLang !== "ES" && currentLang !== "EN")) {
			const browserLang = navigator.language.split("-")[0].toUpperCase();
			currentLang =
				browserLang === "EN" || browserLang === "ES"
					? (browserLang as Language)
					: "ES";
			localStorage.setItem("calendar-lang", currentLang);
		}

		// 2. Set initial radio state
		const radios = document.querySelectorAll('input[name="lang"]');
		radios.forEach((element) => {
			const radio = element as HTMLInputElement;
			if (radio.value === currentLang) {
				radio.checked = true;
			}

			radio.addEventListener("change", (e) => {
				const target = e.target as HTMLInputElement;
				const newLang = target.value as Language;
				localStorage.setItem("calendar-lang", newLang);
				updateUI(newLang);
				window.dispatchEvent(
					new CustomEvent("calendar-lang-change", {
						detail: newLang,
					}),
				);
			});
		});

		// 3. PDF Export
		const btnDownload = document.getElementById("btn-download");
		if (btnDownload) {
			btnDownload.addEventListener("click", async () => {
				const calendar = document.getElementById("calendar-to-export");
				if (!calendar) return;

				// Force light mode for export
				const isDark =
					document.documentElement.classList.contains("dark");
				if (isDark) document.documentElement.classList.remove("dark");

				try {
					const canvas = await html2canvas(calendar, {
						scale: 2,
						useCORS: true,
						logging: false,
						backgroundColor: "#ffffff",
						onclone: (clonedDoc) => {
							// 1. Fix style tags (where Tailwind v4 injects most oklch/oklab)
							const styleTags =
								clonedDoc.getElementsByTagName("style");
							for (let i = 0; i < styleTags.length; i++) {
								const style = styleTags[i];
								if (style.innerHTML) {
									style.innerHTML = style.innerHTML.replace(
										/okl(ab|ch)\([^)]+\)/g,
										"rgba(0,0,0,0.1)",
									);
								}
							}

							// 2. Fix inline styles
							const elements = clonedDoc.querySelectorAll("*");
							elements.forEach((el) => {
								const htmlEl = el as HTMLElement;
								const style = htmlEl.style;
								if (!style) return;

								const props = [
									"color",
									"backgroundColor",
									"borderColor",
									"fill",
									"stroke",
								];
								props.forEach((prop) => {
									const val = style[prop as any];
									if (
										val &&
										(val.includes("oklab") ||
											val.includes("oklch"))
									) {
										style[prop as any] = "";
									}
								});
							});
						},
					});

					// Restore dark mode
					if (isDark) document.documentElement.classList.add("dark");

					const imgData = canvas.toDataURL("image/png");

					// Calculate dimensions (Landscape)
					const pdf = new jsPDF({
						orientation: "landscape",
						unit: "px",
						format: [canvas.width + 40, canvas.height + 100],
					});

					pdf.addImage(
						imgData,
						"PNG",
						20,
						20,
						canvas.width,
						canvas.height,
					);

					// Add custom footer
					pdf.setFontSize(16);
					pdf.setTextColor(100, 100, 100);
					pdf.text(
						"Creado con una herramienta de jvngarcia.com",
						(canvas.width + 40) / 2,
						canvas.height + 70,
						{ align: "center" },
					);

					pdf.save(`planificador-${new Date().getTime()}.pdf`);
				} catch (err) {
					console.error("Error generating PDF", err);
					if (isDark) document.documentElement.classList.add("dark");
				}
			});
		}

		// 4. Initial UI update
		updateUI(currentLang);
	</script>
</Layout>
